# android / gradle
*.iml
.gradle/
local.properties
build/
captures/
.externalNativeBuild/
.cxx/
release/

# credentials — never commit an imported token blob
*.token.json
credentials.json

# The keychain export helper. It carries no secret of its own, but it is a recipe for
# lifting a live credential off a particular machine, and it names the devices and paths
# of the one it was written for. It lives outside this repo now:
#   ~/Personal/ai-usage-companion-notes/tools/export-token.sh
tools/export-token.sh
tools/export-work-token.sh

# ide
.idea/
*.hprof

# macos
.DS_Store

# generated media working files, and the local README render
.rear-demo/
.readme-preview.html

# Signing material. NEVER commit these — the release key is the one secret in this
# project that cannot be rotated: losing control of it means anyone can forge an update,
# and losing the file itself means nobody who installed the app can ever be updated.
*.jks
*.keystore
keystore.properties
release.jks
