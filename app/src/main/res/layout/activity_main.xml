<?xml version="1.0" encoding="utf-8"?>
<!--
  Structural only: no colour or theming attributes here. Global Constraint is
  "Colours from Panel.Palette, never literals" — every colour on this screen
  (background, text, rule lines) is assigned in MainActivity.kt from
  Panel.Palette / Panel.RAMP_STOPS, not hardcoded here. Same for the
  Departure Mono typeface: applied programmatically via
  resources.getFont(R.font.departure_mono), matching the pattern already used
  by RearDialView, rather than android:fontFamily on every node.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Status block: Shizuku running / permission / rear display id, one line each. -->
        <TextView
            android:id="@+id/status_running"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_granted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <!-- Recovery instructions, shown only for the failure state that applies.
             recovery_command is deliberately an EditText inside a HorizontalScrollView,
             not a wrapping TextView: it must stay selectable, on one line, and
             horizontally scrollable so the exact adb one-liner survives a copy. -->
        <TextView
            android:id="@+id/recovery_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/recovery_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/recovery_command"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:cursorVisible="false"
                android:importantForAutofill="no"
                android:inputType="none"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textSize="13sp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/recovery_display_absent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <View
            android:id="@+id/rule_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/grant_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Grant Shizuku permission"
            android:textSize="13sp" />

        <Button
            android:id="@+id/sign_in_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sign in — personal"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/paste_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="top|start"
            android:hint="Paste the work credential here"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="3"
            android:textSize="12sp" />

        <Button
            android:id="@+id/import_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Import token"
            android:textSize="13sp" />

        <View
            android:id="@+id/rule_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/show_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Show on back"
            android:textSize="13sp" />

        <Button
            android:id="@+id/hide_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hide"
            android:textSize="13sp" />


        <View
            android:id="@+id/rule_settings"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/settings_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PANEL"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/settings_title_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="TITLE"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="CLAUDE USAGE"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/geo_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ADVANCED  ▸"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/geo_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <TextView
            android:id="@+id/geo_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="For a phone whose rear display is not the one this was measured on — a larger model, say. Both rings share X and radius so they cannot drift apart. Changes show on the back as you drag."
            android:textSize="10sp" />

        <TextView
            android:id="@+id/geo_cx_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="RING X"
            android:textSize="11sp" />

        <SeekBar
            style="@style/PanelSeekBar"
            android:id="@+id/geo_cx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/geo_cy1_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="PERSONAL Y"
            android:textSize="11sp" />

        <SeekBar
            style="@style/PanelSeekBar"
            android:id="@+id/geo_cy1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/geo_cy2_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="WORK Y"
            android:textSize="11sp" />

        <SeekBar
            style="@style/PanelSeekBar"
            android:id="@+id/geo_cy2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/geo_radius_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="RADIUS"
            android:textSize="11sp" />

        <SeekBar
            style="@style/PanelSeekBar"
            android:id="@+id/geo_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/geo_stroke_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="STROKE"
            android:textSize="11sp" />

        <SeekBar
            style="@style/PanelSeekBar"
            android:id="@+id/geo_stroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/geo_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Reset to measured defaults"
            android:textSize="13sp" />

        </LinearLayout>

        <!--
          Diagnostics slot. Empty here and filled only by the debug variant — the views
          and their class do not exist in a release build at all, rather than existing
          and being hidden.
        -->
        <FrameLayout
            android:id="@+id/debug_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
