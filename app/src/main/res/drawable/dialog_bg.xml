<?xml version="1.0" encoding="utf-8"?>
<!--
  A dialog's window. Square, because everything else in this app is: the panel is
  axis-aligned pixel art and the settings list is flat rows, so a rounded card floating
  over them reads as a piece of a different application.

  Colours are Panel.Palette's, repeated here because a drawable cannot read a Kotlin
  object — BG #1D1F21, RULE #2F3234.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1D1F21" />
    <stroke android:width="1dp" android:color="#2F3234" />
</shape>
