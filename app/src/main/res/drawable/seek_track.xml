<?xml version="1.0" encoding="utf-8"?>
<!-- Track and fill, in the panel's own palette: TRACK behind, the green accent in front,
     both square-cornered to match the thumb and the bars on the rear display. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2C2E" />
            <size android:height="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FFB5BD68" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
