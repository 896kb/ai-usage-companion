<?xml version="1.0" encoding="utf-8"?>
<!--
  Square thumb, like the sliders'. Green when on, track-grey when off, so a toggle reads
  at a glance from the same distance a bar does.

  A rounded thumb here would be the one control that came from somewhere else: everything
  this app draws, from the mascot to the bars to the slider thumbs, is axis-aligned.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFB5BD68" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF555555" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>
</selector>
