<?xml version="1.0" encoding="utf-8"?>
<!-- Square track in the panel's own tones: TRACK when off, a dim green when on, so the
     lit half reads as related to the thumb without competing with it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DB5BD68" />
            <size android:height="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2C2E" />
            <size android:height="16dp" />
        </shape>
    </item>
</selector>
