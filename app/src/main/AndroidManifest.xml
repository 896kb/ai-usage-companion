<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Coarse only: the weather is per city, and a finer fix would name nothing more. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Confirming the device credential before showing an account's name and
         organisation. Not a hardware requirement: a phone with no lock screen skips the
         prompt entirely, so this must never gate installation. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- so the app may ask whether HyperOS's rear-screen app is installed (Setup.kt) -->
    <queries>
        <package android:name="com.xiaomi.subscreencenter" />
    </queries>
    <application
        android:label="AI Usage"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!--
          HyperOS asks, before it lets an activity start on the rear display, whether the
          app declares itself a rear-display app: meta-data miui.rear.policy, 1 for
          allowed, 0 for not, unset otherwise — ActivityStarterImpl.isShouldShowOnRearDisplay
          in miui-services, which logs "allow app" / "should not allow app". Without it,
          every start of the panel aimed at the rear display is aborted, and the panel
          could only ever be started on the front screen and moved across afterwards —
          which is what a panel "respawning on the front screen" looks like when the
          system relaunches it. Declared for the app and again on the panel's activity.
        -->
        <meta-data android:name="miui.rear.policy" android:value="1" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rear panel window. exported=true because HyperOS denies shell
             START_ANY_ACTIVITY against non-exported targets. No intent filters —
             explicit component only. configChanges so the move to display 1 does not
             recreate it.

             android:process=":rear" is LOAD-BEARING and was restored after being
             removed. The theory for removing it was that the default process gets the
             foreground service's importance and would therefore be protected; in
             practice it made things worse. Sharing a process with MainActivity means
             the panel is stopped alongside it when the app is backgrounded, and the
             rear panel went dark the moment the app lost focus. Isolated, the panel
             activity keeps its own lifecycle and survives the app being backgrounded.
             Do not merge these processes again without testing a background soak. -->
        <activity
            android:name=".rear.RearActivity"
            android:exported="true"
            android:process=":rear"
            android:launchMode="singleTask"
            android:taskAffinity="dev.kb896.aiusage.rear"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:theme="@style/RearTheme">
            <meta-data android:name="miui.rear.policy" android:value="1" />
        </activity>

        <!--
          Mirrors other apps' notifications to the rear panel. Binding requires the
          system permission below AND the user granting notification access by hand in
          Settings; neither can be done from code, which is the whole cost of this
          feature. exported must be true: the SYSTEM binds this, not us.
        -->
        <service
            android:name=".service.NotificationRelay"
            android:exported="true"
            android:label="AI Usage panel"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.UsagePollService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
              specialUse, NOT dataSync, and this is the difference between a panel that
              lasts and one that dies every afternoon.

              Since Android 15 a dataSync foreground service is capped at SIX HOURS in
              any 24, after which the system stops it. This app targets 36. That cap
              describes a sync job perfectly and describes this service not at all: it
              is not moving data on a schedule, it is holding a second display alive for
              as long as the phone is on. When it is stopped the panel goes with it, and
              nothing on the device says why.

              specialUse is the category for exactly this — a foreground service whose
              purpose none of the standard types fit — and it carries no time limit. It
              costs a declared reason, below, which is the honest trade.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously drives an always-on secondary display panel and polls usage limits for it" />
        </service>

        <!-- Restarts UsagePollService after a device reboot — see BootReceiver's
             KDoc for why this alone does not mean the panel reappears immediately
             (Shizuku itself needs a manual restart on this device). directBootAware
             left at its default "false": placement needs TokenStore's Keystore
             access, which needs user-unlocked (credential-encrypted) storage
             anyway, so there is nothing useful this receiver could do before then. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
