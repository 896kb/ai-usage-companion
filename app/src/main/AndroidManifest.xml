<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="Claude Status"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rear panel window. exported=true because HyperOS denies shell
             START_ANY_ACTIVITY against non-exported targets. No intent filters —
             explicit component only. Own process so panel input can't ANR the app.
             configChanges so the move to display 1 does not recreate it. -->
        <activity
            android:name=".rear.RearActivity"
            android:exported="true"
            android:process=":rear"
            android:launchMode="singleTask"
            android:taskAffinity="dev.kb896.aiusage.rear"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <service
            android:name=".service.UsagePollService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Restarts UsagePollService after a device reboot — see BootReceiver's
             KDoc for why this alone does not mean the panel reappears immediately
             (Shizuku itself needs a manual restart on this device). directBootAware
             left at its default "false": placement needs TokenStore's Keystore
             access, which needs user-unlocked (credential-encrypted) storage
             anyway, so there is nothing useful this receiver could do before then. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
