<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Claude Status"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rear panel window. exported=true because HyperOS denies shell
             START_ANY_ACTIVITY against non-exported targets. No intent filters —
             explicit component only. Own process so panel input can't ANR the app.
             configChanges so the move to display 1 does not recreate it. -->
        <activity
            android:name=".rear.RearActivity"
            android:exported="true"
            android:process=":rear"
            android:launchMode="singleTask"
            android:taskAffinity="dev.rgarjoaba.claudestatus.rear"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
