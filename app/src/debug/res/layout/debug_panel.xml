<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only diagnostics: a raw dump of the payload broadcast to the panel, and an
  animation harness showing every mascot state at once. Neither is a feature; both are
  tools for whoever is building this. This file lives in src/debug, so a release build
  has no reference to MascotStripView and cannot inflate it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
      Collapsed by default. These are tools for whoever is building this, and even in a
      debug build they are not what the app is for — a reset button and a five-mascot
      animation harness sitting open above the real settings puts scaffolding in front of
      the thing being scaffolded.
    -->
    <TextView
        android:id="@+id/debug_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="DEBUG  ▸"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/debug_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <Button
        android:id="@+id/debug_reset_art"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Restore the built-in mark"
        android:textSize="13sp" />

<View
            android:id="@+id/rule_3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/preview_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="STATE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/preview_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/mascot_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MASCOT STATES"
            android:textSize="12sp" />

        <dev.kb896.aiusage.ui.MascotStripView
            android:id="@+id/mascot_strip"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/calls_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECENT CALLS"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/calls_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:textSize="12sp" />



    </LinearLayout>
</LinearLayout>
